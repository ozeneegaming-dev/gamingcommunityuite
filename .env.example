# Copiază în `.env` și completează. `install.sh` (Task 17) îl generează automat.

# Domeniul public. `localhost` = HTTPS cu certificat local (Caddy), pentru test.
GCS_DOMAIN=localhost

# PostgreSQL (serviciul `postgres` din compose)
POSTGRES_USER=redline
POSTGRES_PASSWORD=schimba-parola
POSTGRES_DB=redline
DATABASE_URL=postgresql://redline:schimba-parola@postgres:5432/redline

# Redis
REDIS_URL=redis://redis:6379

# MinIO (compatibil S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=redline
S3_SECRET_KEY=schimba-cheia-minim-8-caractere
S3_BUCKET=redline

# Secret aplicație (openssl rand -hex 32)
GCS_SECRET=schimba-secretul

# Folderul de configurare al installer-ului (volumul gcsconfig)
GCS_CONFIG_DIR=/app/config
