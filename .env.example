# Copiază în `.env` și completează. `install.sh` îl generează automat (vezi docs/INSTALL.md).

# Domeniul public. `localhost` = HTTPS cu certificat local (Caddy), pentru test.
GCS_DOMAIN=localhost
# Adresa publică a site-ului (folosită de autentificare).
GCS_BASE_URL=https://localhost

# PostgreSQL (serviciul `postgres` din compose)
POSTGRES_USER=gcs
POSTGRES_PASSWORD=schimba-parola
POSTGRES_DB=gcs
DATABASE_URL=postgresql://gcs:schimba-parola@postgres:5432/gcs

# Redis
REDIS_URL=redis://redis:6379

# MinIO (compatibil S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=gcs
S3_SECRET_KEY=schimba-cheia-minim-8-caractere
S3_BUCKET=gcs

# Secret aplicație (openssl rand -hex 32)
GCS_SECRET=schimba-secretul

# Adresa serviciului `gcs-realtime` pentru browser. Gol = aceeași origine (Caddy trimite `/socket.io/*` la realtime).
GCS_REALTIME_URL=

# Folderul de configurare al installer-ului (volumul gcsconfig)
GCS_CONFIG_DIR=/app/config
