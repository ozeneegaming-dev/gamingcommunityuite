// RED-LINE — schema nucleului (Etapa 1, Task 3).
// Tabele: snake_case plural, fără prefix (spec §4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Utilizatori și autentificare (Better Auth) ─────────────────────────────

model User {
  id                     String    @id @default(cuid())
  name                   String
  nameNormalized         String    @unique
  email                  String    @unique // salvat lowercase
  emailVerified          Boolean   @default(false)
  image                  String?
  primaryGroupId         Int
  previousPrimaryGroupId Int?
  /// Grupul afișat (stilul numelui): calculat de GCS dintre grupul principal și cele secundare, după „Prioritate
  /// afișare”, sau cel ales de membru. `null` = grupul principal.
  nameGroupId            Int?
  /// Grupul ales de membru ca grup afișat (Setări), dacă grupul permite; `null` = automat (după prioritate).
  displayGroupChoiceId   Int?
  locale                 String    @default("ro")
  timezone               String    @default("Europe/Bucharest")
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?
  lastActiveAt           DateTime?
  lastAcpAuthAt          DateTime?
  lastAcpAuthIp          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  primaryGroup       Group               @relation("UserPrimaryGroup", fields: [primaryGroupId], references: [id], onDelete: Restrict)
  nameGroup          Group?              @relation("UserNameGroup", fields: [nameGroupId], references: [id], onDelete: SetNull)
  displayGroupChoice Group?              @relation("UserDisplayGroupChoice", fields: [displayGroupChoiceId], references: [id], onDelete: SetNull)
  groups             UserGroup[]
  accounts           Account[]
  sessions           Session[]
  twoFactors         TwoFactor[]
  warnings           Warning[]           @relation("WarningTarget")
  warningsIssued     Warning[]           @relation("WarningIssuer")
  bans               Ban[]               @relation("BanTarget")
  bansCreated        Ban[]               @relation("BanCreator")
  moderatorOf        Moderator[]
  acpRoles           AcpRoleAssignment[]
  dashboardLayout    AcpDashboardLayout?

  // Forum (etapa 2). Contoarele sunt denormalizate și se actualizează în tranzacția scrierii.
  postsCount         Int @default(0)
  approvedPostsCount Int @default(0)
  reputation         Int @default(0)

  topics         Topic[]           @relation("TopicAuthor")
  posts          Post[]            @relation("PostAuthor")
  postRevisions  PostRevision[]
  reactionsGiven ContentReaction[]
  pollVotes      PollVote[]
  readMarkers    ReadMarker[]
  forumReadMarks ForumReadMark[]
  follows        Follow[]
  reports        Report[]          @relation("ReportReporter")
  attachments    Attachment[]

  // Profil, social, VIP (etapa 3). `privacy`: { profile, messages, wall, showOnline } (specul etapei 3 §6).
  bio               String  @default("")
  accentColor       String?
  coverAttachmentId String?
  coverPositionY    Int     @default(50)
  privacy           Json    @default("{}")
  points            Int     @default(0)
  followersCount    Int     @default(0)
  solutionsCount    Int     @default(0)
  rankId            Int?
  nameStyleId       Int?
  avatarFrameId     Int?

  /// Ziua de naștere (fără oră) și dacă e publică (comanda `/zi-de-nastere` din Chat Pro, profilul).
  birthday        DateTime? @db.Date
  birthdayVisible Boolean   @default(false)

  // UI modern (etapa 5). `prefs`: { sound, toasts, theme } (specul etapei 5).
  signatureJson Json?
  signatureHtml String  @default("")
  customTitle   String?
  prefs         Json    @default("{}")

  /// Importul din altă platformă: IP-ul de la înregistrarea pe site-ul vechi (apare în uneltele IP din ACP).
  registrationIp String?

  userPermissions UserPermission[]
  chatRoomsOwned  ChatChannel[]         @relation("ChatRoomOwner")
  chatRooms       ChatRoomMember[]      @relation("ChatRoomMember")
  chatReactions   ChatMessageReaction[]
  /// Serverele de joc la care membrul e admin (aplicația Servere).
  gameServerAdmin GameServerAdmin[]
  /// Puntea cu serverele de joc: identitățile de joc legate, codurile de legare, intrările de admin și tichetele.
  gamePlayers     GamePlayer[]
  gameLinkCodes   GameLinkCode[]
  gameAdmins      GameAdmin[]
  gameTickets     GameTicket[]          @relation("GameTicketAuthor")
  /// Aplicația Clanuri: clanurile membrului, cererile / invitațiile lui, invitațiile trimise și clanurile fondate.
  clanMemberships ClanMember[]
  clanRequests    ClanRequest[]         @relation("ClanRequestUser")
  clanInvitesSent ClanRequest[]         @relation("ClanRequestInviter")
  clansCreated    Clan[]                @relation("ClanCreator")

  rank             Rank?                     @relation(fields: [rankId], references: [id], onDelete: SetNull)
  nameStyle        NameStyle?                @relation(fields: [nameStyleId], references: [id], onDelete: SetNull)
  avatarFrame      AvatarFrame?              @relation(fields: [avatarFrameId], references: [id], onDelete: SetNull)
  profileValues    ProfileFieldValue[]
  wallPosts        StatusUpdate[]            @relation("StatusProfile")
  statusesWritten  StatusUpdate[]            @relation("StatusAuthor")
  ignoring         UserIgnore[]              @relation("IgnoreOwner")
  ignoredBy        UserIgnore[]              @relation("IgnoreTarget")
  conversations    ConversationParticipant[]
  messagesWritten  ConversationMessage[]
  badges           UserBadge[]
  achievementLog   AchievementLog[]
  vipSubscriptions VipSubscription[]
  /// Aspectul publicat de pluginuri (capabilitatea `appearance`, Studio VIP).
  appearances      MemberAppearance[]

  // Timp real (etapa 4).
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  chatMessages            ChatMessage[]            @relation("ChatAuthor")
  chatMutes               ChatMute[]               @relation("ChatMuted")
  /// Chat Pro (aplicația premium): profilul de chat, statisticile zilnice și perioadele câștigate.
  chatProProfile          ChatProProfile?
  chatProStats            ChatProDailyStat[]
  chatProWins             ChatProWinner[]

  @@index([primaryGroupId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

/// Secretul TOTP și codurile de rezervă (plugin-ul `twoFactor` din Better Auth). Câmpurile sunt criptate de Better Auth.
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

// ─── Grupuri și permisiuni (spec §6) ────────────────────────────────────────

model Group {
  id          Int     @id @default(autoincrement())
  key         String  @unique // root_admin, admin, …, vip_legend; custom_<id> pentru grupurile din ACP
  name        String
  isProtected Boolean @default(false)
  isVip       Boolean @default(false)
  color       String?
  nameStyle   Json?
  title       String?
  position    Int     @default(0)
  /// Etapa 5: iconița Font Awesome, banner-ul din postbit (culoare sau gradient validat) și apariția în legenda grupurilor.
  icon        String?
  banner      String?
  inLegend    Boolean @default(true)

  primaryUsers         User[]                @relation("UserPrimaryGroup")
  nameUsers            User[]                @relation("UserNameGroup")
  displayChoiceUsers   User[]                @relation("UserDisplayGroupChoice")
  members              UserGroup[]
  settings             GroupSetting[]
  containerPermissions ContainerPermission[]
  moderators           Moderator[]
  acpRoles             AcpRoleAssignment[]
  promotionsTo         GroupPromotion[]
  vipSubscriptions     VipSubscription[]
  vipLog               VipLog[]
  /// VIP pe serverele de joc (flag-urile grupului pe fiecare server).
  gameVipMappings      GameVipMapping[]

  @@map("groups")
}

/// Grupurile secundare ale unui user.
model UserGroup {
  userId  String
  groupId Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_groups")
}

model GroupSetting {
  id      Int    @id @default(autoincrement())
  groupId Int
  key     String
  value   Json

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
  @@map("group_settings")
}

model ContainerPermission {
  id            Int    @id @default(autoincrement())
  containerType String
  containerId   String
  groupId       Int
  action        String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([containerType, containerId, groupId, action])
  @@index([containerType, containerId])
  @@map("container_permissions")
}

model ContainerInherit {
  id            Int     @id @default(autoincrement())
  containerType String
  containerId   String
  parentId      String?
  inherits      Boolean @default(false)

  @@unique([containerType, containerId])
  @@map("container_inherit")
}

model Moderator {
  id            Int      @id @default(autoincrement())
  containerType String
  containerId   String
  userId        String?
  groupId       Int?
  powers        String[]

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([containerType, containerId])
  @@map("moderators")
}

// ─── Bannuri și avertismente (spec §6.5) ────────────────────────────────────

enum BanType {
  ACCOUNT
  IP
  EMAIL
}

model Ban {
  id          String    @id @default(cuid())
  type        BanType
  value       String
  userId      String?
  reason      String
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  liftedAt    DateTime?

  user      User? @relation("BanTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("BanCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type, value])
  @@index([userId])
  @@map("bans")
}

model Warning {
  id         String    @id @default(cuid())
  userId     String
  points     Int
  reason     String
  expiresAt  DateTime?
  issuedById String?
  createdAt  DateTime  @default(now())

  user     User  @relation("WarningTarget", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User? @relation("WarningIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("warnings")
}

enum WarningActionType {
  MODERATE_POSTS
  RESTRICT
  BAN
}

model WarningAction {
  id            Int               @id @default(autoincrement())
  threshold     Int               @unique
  action        WarningActionType
  durationHours Int?

  @@map("warning_actions")
}

// ─── ACP (spec §6.4, §12) ───────────────────────────────────────────────────

model AcpRole {
  id   Int    @id @default(autoincrement())
  name String @unique

  permissions AcpRolePermission[]
  assignments AcpRoleAssignment[]

  @@map("acp_roles")
}

model AcpRolePermission {
  id        Int     @id @default(autoincrement())
  roleId    Int
  section   String
  canView   Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  role AcpRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, section])
  @@map("acp_role_permissions")
}

model AcpRoleAssignment {
  id      Int     @id @default(autoincrement())
  roleId  Int
  userId  String?
  groupId Int?

  role  AcpRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user  User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([groupId])
  @@map("acp_role_assignments")
}

model AcpDashboardLayout {
  userId String @id
  layout Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("acp_dashboard_layouts")
}

model AdminNote {
  id          Int      @id @default(1)
  body        String   @default("")
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("admin_notes")
}

// ─── Sistem ─────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model SystemState {
  id          Int       @id @default(1)
  installedAt DateTime?
  permVersion Int       @default(0)
  appVersion  String    @default("1.0.0")
  /// Seed-urile făcute o singură dată (ex. `layout:index`), ca alegerile adminului să nu fie refăcute la repornire.
  seedMarks   String[]  @default([])

  @@map("system_state")
}

/// Jurnalul ACP. `actorId` nu are cheie străină, ca intrările să rămână după ștergerea unui user.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─── Forum (etapa 2, specul etapei §4) ──────────────────────────────────────

enum ForumType {
  CATEGORY
  FORUM
  LINK
  QA
}

/// Starea de vizibilitate a unui topic sau a unei postări.
enum ContentVisibility {
  VISIBLE
  PENDING
  HIDDEN
}

enum ReportStatus {
  OPEN
  CLOSED
}

/// Categorie, forum, subforum sau link. `parentId` null = rădăcină. Câmpurile `last*` nu au chei străine (evită ciclurile).
model Forum {
  id              Int       @id @default(autoincrement())
  parentId        Int?
  type            ForumType @default(FORUM)
  name            String
  slug            String
  description     String    @default("")
  icon            String?
  color           String?
  position        Int       @default(0)
  linkUrl         String?
  requireApproval Boolean   @default(false)
  /// Etapa 5: pe câte coloane se afișează subforumurile (1–5).
  subforumColumns Int       @default(2)
  topicsCount     Int       @default(0)
  postsCount      Int       @default(0)
  lastPostId      Int?
  lastPostAt      DateTime?
  lastTopicId     Int?
  lastPosterId    String?
  createdAt       DateTime  @default(now())

  parent      Forum?        @relation("ForumTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Forum[]       @relation("ForumTree")
  topics      Topic[]
  prefixes    ForumPrefix[]
  /// Serverele de joc care au acest forum ca „forumul serverului”.
  gameServers GameServer[]
  /// Clanul care are acest forum ca forum privat.
  clan        Clan?

  @@index([parentId, position])
  @@map("forums")
}

model Topic {
  id           Int                      @id @default(autoincrement())
  forumId      Int
  title        String
  slug         String
  authorId     String?
  prefixId     Int?
  visibility   ContentVisibility        @default(VISIBLE)
  pinned       Boolean                  @default(false)
  locked       Boolean                  @default(false)
  featured     Boolean                  @default(false)
  solvedPostId Int?
  firstPostId  Int?
  lastPostId   Int?
  lastPostAt   DateTime                 @default(now())
  lastPosterId String?
  repliesCount Int                      @default(0)
  viewsCount   Int                      @default(0)
  createdAt    DateTime                 @default(now())
  searchVector Unsupported("tsvector")?

  forum       Forum        @relation(fields: [forumId], references: [id], onDelete: Cascade)
  author      User?        @relation("TopicAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  prefix      TopicPrefix? @relation(fields: [prefixId], references: [id], onDelete: SetNull)
  posts       Post[]
  tags        TopicTag[]
  poll        Poll?
  readMarkers ReadMarker[]

  @@index([forumId, visibility, pinned(sort: Desc), lastPostAt(sort: Desc)])
  @@index([authorId])
  /// Fluxul de activitate (`/activity`): topicurile noi, cele mai noi primele.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("topics")
}

model Post {
  id           Int                      @id @default(autoincrement())
  topicId      Int
  authorId     String?
  contentJson  Json
  contentHtml  String
  visibility   ContentVisibility        @default(VISIBLE)
  hiddenById   String?
  hiddenReason String?
  editedAt     DateTime?
  editedById   String?
  ip           String?
  createdAt    DateTime                 @default(now())
  searchVector Unsupported("tsvector")?

  topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author    User?          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  revisions PostRevision[]

  @@index([topicId, visibility, id])
  @@index([authorId, createdAt])
  /// Fluxul de activitate și clasamentul pe perioade (postările create recent).
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("posts")
}

model PostRevision {
  id          Int      @id @default(autoincrement())
  postId      Int
  contentJson Json
  contentHtml String
  editorId    String?
  createdAt   DateTime @default(now())

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  editor User? @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@map("post_revisions")
}

model TopicPrefix {
  id       Int    @id @default(autoincrement())
  name     String
  color    String
  position Int    @default(0)

  topics Topic[]
  forums ForumPrefix[]

  @@map("topic_prefixes")
}

/// Prefixele permise pe un forum. Niciun rând pentru forum = toate prefixele sunt permise.
model ForumPrefix {
  forumId  Int
  prefixId Int

  forum  Forum       @relation(fields: [forumId], references: [id], onDelete: Cascade)
  prefix TopicPrefix @relation(fields: [prefixId], references: [id], onDelete: Cascade)

  @@id([forumId, prefixId])
  @@map("forum_prefixes")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  topics TopicTag[]

  @@map("tags")
}

model TopicTag {
  topicId Int
  tagId   Int

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([topicId, tagId])
  @@index([tagId])
  @@map("topic_tags")
}

model Poll {
  id       Int       @id @default(autoincrement())
  topicId  Int       @unique
  question String
  multiple Boolean   @default(false)
  closesAt DateTime?

  topic   Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id         Int    @id @default(autoincrement())
  pollId     Int
  text       String
  position   Int    @default(0)
  votesCount Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  pollId    Int
  optionId  Int
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, optionId, userId])
  @@index([pollId, userId])
  @@map("poll_votes")
}

/// Reacțiile configurabile din ACP. `weight` se adună la reputația autorului.
model Reaction {
  id       Int     @id @default(autoincrement())
  key      String  @unique
  label    String
  symbol   String
  color    String
  weight   Int     @default(0)
  position Int     @default(0)
  enabled  Boolean @default(true)

  given ContentReaction[]

  @@map("reactions")
}

/// O reacție pe orice conținut (`forums.post`, `downloads.file`…). Una per user per conținut.
model ContentReaction {
  id          Int      @id @default(autoincrement())
  contentType String
  contentId   String
  userId      String
  reactionId  Int
  createdAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reaction Reaction @relation(fields: [reactionId], references: [id], onDelete: Cascade)

  @@unique([contentType, contentId, userId])
  @@index([contentType, contentId])
  /// Clasamentul pe perioade: reacțiile primite recent.
  @@index([createdAt])
  @@map("content_reactions")
}

model ReadMarker {
  userId         String
  topicId        Int
  lastReadPostId Int
  updatedAt      DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([userId, topicId])
  @@index([topicId])
  @@map("read_markers")
}

/// „Marchează tot citit” pe un forum: topicurile fără activitate după `markedAt` sunt citite.
model ForumReadMark {
  userId   String
  forumId  Int
  markedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, forumId])
  @@map("forum_read_marks")
}

model Follow {
  id          Int      @id @default(autoincrement())
  userId      String
  contentType String
  contentId   String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId])
  @@index([contentType, contentId])
  @@map("follows")
}

model Report {
  id          String       @id @default(cuid())
  contentType String
  contentId   String
  reporterId  String?
  reason      String
  status      ReportStatus @default(OPEN)
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime     @default(now())

  reporter User? @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([contentType, contentId])
  @@map("reports")
}

/// Un fișier încărcat. `contentType`/`contentId` sunt null până la salvarea conținutului care îl folosește.
model Attachment {
  id          String   @id @default(cuid())
  ownerId     String?
  storageKey  String   @unique
  filename    String
  mime        String
  size        Int
  width       Int?
  height      Int?
  contentType String?
  contentId   String?
  createdAt   DateTime @default(now())

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([contentType, contentId])
  @@index([ownerId, createdAt])
  @@map("attachments")
}

/// Macro de moderare: `actions` = listă de pași (lock, pin, feature, move, prefix, reply). `forumIds` gol = toate forumurile.
model ModSavedAction {
  id       Int    @id @default(autoincrement())
  name     String
  forumIds Int[]
  actions  Json

  @@map("mod_saved_actions")
}

// ─── Profil, social, VIP (etapa 3, specul etapei §4) ─────────────────────────

enum ProfileFieldType {
  TEXT
  TEXTAREA
  URL
  NUMBER
  SELECT
  /// Etapa 5: select cu o imagine pe opțiune (ex. „Armă favorită”).
  IMAGE_SELECT
}

/// Tabul în care apare câmpul pe profil.
enum ProfileFieldSection {
  ABOUT
  GAMES
}

enum FieldVisibility {
  PUBLIC
  MEMBERS
  STAFF
}

/// Câmp custom de profil, definit în ACP → Membri → Setări membri → Profiluri.
model ProfileField {
  id            Int                 @id @default(autoincrement())
  key           String              @unique
  label         String
  type          ProfileFieldType    @default(TEXT)
  options       String[]
  section       ProfileFieldSection @default(ABOUT)
  required      Boolean             @default(false)
  maxLength     Int                 @default(200)
  visibility    FieldVisibility     @default(PUBLIC)
  showOnCard    Boolean             @default(false)
  position      Int                 @default(0)
  /// Etapa 5: iconița, afișarea în postbit și imaginile opțiunilor (`IMAGE_SELECT`: opțiune → URL public).
  icon          String?
  showInPostbit Boolean             @default(false)
  optionImages  Json                @default("{}")

  values ProfileFieldValue[]

  @@map("profile_fields")
}

model ProfileFieldValue {
  userId  String
  fieldId Int
  /// Textul simplu (postbit, card, căutare); la câmpurile „Text lung” e textul documentului de mai jos.
  value   String
  /// Câmpurile „Text lung” (`TEXTAREA`) formatate cu editorul: documentul și HTML-ul randat de server la salvare.
  /// Lipsă (valorile vechi) = textul `value` se afișează ca paragrafe (conversie la citire).
  json    Json?
  html    String @default("")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  field ProfileField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([userId, fieldId])
  @@index([fieldId])
  @@map("profile_field_values")
}

/// Un status pe peretele unui profil. `parentId` = răspuns (un singur nivel).
model StatusUpdate {
  id            Int               @id @default(autoincrement())
  profileUserId String
  authorId      String?
  parentId      Int?
  contentJson   Json
  contentHtml   String
  visibility    ContentVisibility @default(VISIBLE)
  repliesCount  Int               @default(0)
  ip            String?
  createdAt     DateTime          @default(now())

  profileUser User           @relation("StatusProfile", fields: [profileUserId], references: [id], onDelete: Cascade)
  author      User?          @relation("StatusAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent      StatusUpdate?  @relation("StatusReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     StatusUpdate[] @relation("StatusReplies")

  @@index([profileUserId, parentId, createdAt])
  /// Fluxul de activitate: statusurile noi de pe toate profilurile.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("status_updates")
}

model UserIgnore {
  userId    String
  ignoredId String
  posts     Boolean  @default(true)
  messages  Boolean  @default(true)
  createdAt DateTime @default(now())

  user    User @relation("IgnoreOwner", fields: [userId], references: [id], onDelete: Cascade)
  ignored User @relation("IgnoreTarget", fields: [ignoredId], references: [id], onDelete: Cascade)

  @@id([userId, ignoredId])
  @@index([ignoredId])
  @@map("user_ignores")
}

/// Conversație privată cu mai mulți participanți. `lastMessageId` nu are cheie străină (evită ciclul).
model Conversation {
  id            Int      @id @default(autoincrement())
  title         String
  starterId     String?
  lastMessageId Int?
  lastMessageAt DateTime @default(now())
  messagesCount Int      @default(0)
  createdAt     DateTime @default(now())

  participants ConversationParticipant[]
  messages     ConversationMessage[]

  @@map("conversations")
}

/// `leftAt` setat = a părăsit conversația (nu o mai vede).
model ConversationParticipant {
  conversationId    Int
  userId            String
  joinedAt          DateTime  @default(now())
  leftAt            DateTime?
  lastReadMessageId Int       @default(0)
  invitedById       String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_participants")
}

model ConversationMessage {
  id             Int       @id @default(autoincrement())
  conversationId Int
  authorId       String?
  contentJson    Json
  contentHtml    String
  editedAt       DateTime?
  ip             String?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([conversationId, id])
  @@map("conversation_messages")
}

/// Rang: pragurile null nu se cer. Se acordă cel mai înalt rang (după `position`) cu toate pragurile completate atinse.
model Rank {
  id            Int     @id @default(autoincrement())
  name          String
  icon          String?
  minPosts      Int?
  minPoints     Int?
  minReputation Int?
  position      Int     @default(0)

  users User[]

  @@map("ranks")
}

/// Badge: insignă desenată (specul 2026-10-07-insigne-grafice) sau imagine proprie. `color` = emailul/panglica
/// insignei (categoria); `artShape`/`artTier`/`artIcon` = forma, metalul și iconița (null = implicite); `symbol` =
/// textul insignei (1–3 caractere) când nu are iconiță. `manual` = acordat doar de staff.
model Badge {
  id                Int     @id @default(autoincrement())
  key               String  @unique
  name              String
  description       String  @default("")
  symbol            String?
  imageAttachmentId String?
  color             String
  artShape          String?
  artTier           String?
  artIcon           String?
  manual            Boolean @default(false)
  points            Int     @default(0)
  position          Int     @default(0)

  users UserBadge[]
  rules AchievementRule[]

  @@map("badges")
}

model UserBadge {
  id          Int      @id @default(autoincrement())
  userId      String
  badgeId     Int
  awardedById String?
  reason      String?
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([badgeId])
  @@map("user_badges")
}

/// Ce declanșează o regulă. `EACH_*` dau puncte la fiecare eveniment; restul au prag și se acordă o singură dată.
enum AchievementTrigger {
  POSTS_COUNT
  REPUTATION
  POINTS
  MEMBER_DAYS
  SOLUTIONS_COUNT
  IS_VIP
  EACH_POST
  EACH_REACTION_RECEIVED
  EACH_SOLUTION
}

model AchievementRule {
  id        Int                @id @default(autoincrement())
  key       String?            @unique // regulile din seed; null pentru cele create în ACP
  name      String
  trigger   AchievementTrigger
  threshold Int                @default(0)
  points    Int                @default(0)
  badgeId   Int?
  enabled   Boolean            @default(true)
  position  Int                @default(0)

  badge Badge?           @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  log   AchievementLog[]

  @@map("achievement_rules")
}

/// Ce s-a acordat prin reguli. `uniqueKey` (ex. `rule:3`, `post:120`) împiedică acordarea dublă.
model AchievementLog {
  id         Int      @id @default(autoincrement())
  userId     String
  ruleId     Int?
  points     Int      @default(0)
  uniqueKey  String?
  contentRef String?
  createdAt  DateTime @default(now())

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule AchievementRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([userId, uniqueKey])
  @@index([userId, createdAt])
  /// Clasamentul pe perioade: XP-ul primit recent.
  @@index([createdAt])
  @@map("achievement_log")
}

/// Promovare automată: din unul dintre `fromGroupIds`, cu toate pragurile completate atinse → `toGroupId`.
model GroupPromotion {
  id            Int     @id @default(autoincrement())
  name          String
  fromGroupIds  Int[]
  toGroupId     Int
  asPrimary     Boolean @default(true)
  minPosts      Int?
  minDays       Int?
  minReputation Int?
  minPoints     Int?
  enabled       Boolean @default(true)
  position      Int     @default(0)

  toGroup Group @relation(fields: [toGroupId], references: [id], onDelete: Cascade)

  @@map("group_promotions")
}

enum VipSource {
  MANUAL
  STORE
}

enum VipStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum VipAction {
  GRANT
  EXTEND
  REVOKE
  EXPIRE
}

/// Abonament VIP. `expiresAt` null = permanent. Cel mult unul `ACTIVE` pe user (index unic parțial, în migrație).
model VipSubscription {
  id          Int       @id @default(autoincrement())
  userId      String
  groupId     Int
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  source      VipSource @default(MANUAL)
  grantedById String?
  status      VipStatus @default(ACTIVE)
  warnedAt    DateTime?
  madePrimary Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([userId, status])
  @@map("vip_subscriptions")
}

model VipLog {
  id        Int       @id @default(autoincrement())
  userId    String
  groupId   Int?
  action    VipAction
  expiresAt DateTime?
  actorId   String?
  note      String?
  createdAt DateTime  @default(now())

  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("vip_log")
}

/// Stil de nume ales de user (clasa `gcs-name--{key}`; cheile încep cu `ns_`). Disponibil pentru toți, pe grupuri sau pe badge-uri.
model NameStyle {
  id        Int     @id @default(autoincrement())
  key       String  @unique
  name      String
  style     Json
  allGroups Boolean @default(false)
  groupIds  Int[]
  badgeIds  Int[]
  position  Int     @default(0)

  users User[]

  @@map("name_styles")
}

enum FrameKind {
  CSS
  IMAGE
}

/// Ramă de avatar (clasa `gcs-avatarFrame--{key}`): CSS (conic-gradient) sau imagine.
model AvatarFrame {
  id                Int       @id @default(autoincrement())
  key               String    @unique
  name              String
  kind              FrameKind @default(CSS)
  style             Json?
  imageAttachmentId String?
  allGroups         Boolean   @default(false)
  groupIds          Int[]
  badgeIds          Int[]
  position          Int       @default(0)

  users User[]

  @@map("avatar_frames")
}

// ─── Timp real (etapa 4, specul etapei §4) ───────────────────────────────────

enum NotificationEmail {
  OFF
  INSTANT
  DIGEST
}

/**
 * O notificare. Notificările necitite de același fel, pe același conținut, se grupează (`groupKey`; index unic
 * parțial `WHERE readAt IS NULL`, în migrație): `count` crește, iar `actorIds` ține ultimii actori.
 */
model Notification {
  id         Int       @id @default(autoincrement())
  userId     String
  type       String
  targetType String
  targetId   String
  groupKey   String
  actorIds   String[]
  count      Int       @default(1)
  data       Json
  readAt     DateTime?
  emailedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, updatedAt])
  @@index([readAt, emailedAt])
  @@map("notifications")
}

model NotificationPreference {
  userId String
  type   String
  site   Boolean           @default(true)
  email  NotificationEmail @default(DIGEST)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("notification_preferences")
}

/**
 * Valorile implicite pe tip (ACP → Membri → Setări membri → Notificări).
 */
model NotificationDefault {
  type  String            @id
  site  Boolean           @default(true)
  email NotificationEmail @default(DIGEST)

  @@map("notification_defaults")
}

/**
 * Un canal de chat. Permisiunile sunt în matricea pe container (`containerType = "chat"`, id = cheia).
 */
model ChatChannel {
  id              Int          @id @default(autoincrement())
  key             String       @unique
  name            String
  description     String       @default("")
  position        Int          @default(0)
  slowModeSeconds Int          @default(0)
  retentionDays   Int          @default(7)
  enabled         Boolean      @default(true)
  showOnHome      Boolean      @default(false)
  /// Etapa 5: camerele private (cu invitați) și anunțul fixat.
  type            ChatRoomType @default(PUBLIC)
  ownerId         String?
  pinnedMessageId Int?
  createdAt       DateTime     @default(now())

  messages ChatMessage[]
  mutes    ChatMute[]
  members  ChatRoomMember[]
  owner    User?            @relation("ChatRoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@map("chat_channels")
}

model ChatMessage {
  id          Int       @id @default(autoincrement())
  channelId   Int
  authorId    String?
  body        String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedById String?
  editedAt    DateTime?
  /// Chat v3: imaginile și mesajele vocale încărcate (`[{ id, kind, width, height }]`); atașamentele sunt `chat.message`.
  files       Json      @default("[]")
  /// Răspunsul citat (Chat Pro): mesajul la care răspunde; dispare odată cu el.
  replyToId   Int?
  /// Datele extensiilor (Chat Pro): `{ first?, bot? }`; chat-ul standard le ignoră.
  meta        Json?

  channel   ChatChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User?                 @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reactions ChatMessageReaction[]
  replyTo   ChatMessage?          @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[]         @relation("ChatReply")

  @@index([channelId, id])
  @@index([createdAt])
  /// Istoricul Chat Pro (căutarea după membru) și ștergerea / unirea conturilor.
  @@index([authorId, id])
  @@map("chat_messages")
}

/**
 * Mute în chat: pe un canal sau pe toate (`channelId` null); `until` null = permanent.
 */
model ChatMute {
  id          Int       @id @default(autoincrement())
  userId      String
  channelId   Int?
  until       DateTime?
  reason      String    @default("")
  createdById String?
  createdAt   DateTime  @default(now())

  user    User         @relation("ChatMuted", fields: [userId], references: [id], onDelete: Cascade)
  channel ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([userId, until])
  @@map("chat_mutes")
}

// ─── UI modern și personalizare (etapa 5, specul etapei §4) ──────────────────

enum ChatRoomType {
  PUBLIC
  PRIVATE
}

/// Permisiuni individuale: o valoare pentru un singur membru, peste cea a grupurilor lui.
model UserPermission {
  userId    String
  key       String
  value     Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@map("user_permissions")
}

/// Aplicațiile opționale (Chat, VIP; în etapa 6 Clanuri, Servere), activate sau dezactivate din ACP.
model App {
  key       String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("apps")
}

/// Meniul din header. `label`: { "ro": "...", "en": "..." } sau { "key": "cheie de traducere" } pentru cele implicite.
model NavItem {
  id       Int     @id @default(autoincrement())
  parentId Int?
  position Int     @default(0)
  label    Json
  icon     String?
  href     String?
  appKey   String?
  groups   Int[]
  newTab   Boolean @default(false)
  enabled  Boolean @default(true)

  parent   NavItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavItem[] @relation("NavTree")

  @@index([parentId, position])
  @@map("nav_items")
}

/// O temă: tokenurile (dark + light), fonturile, raza, lățimea, logo, favicon; `draft` = modificările nepublicate.
/// CSS-ul extra stă în fișierele temei (`theme_css_files`), iar markup-ul modificat în `theme_templates`.
model Theme {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  name       String
  isDefault  Boolean  @default(false)
  enabled    Boolean  @default(true)
  settings   Json     @default("{}")
  logoUrl    String?
  faviconUrl String?
  draft      Json?
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cssFiles         ThemeCssFile[]
  templates        ThemeTemplate[]
  templateVersions ThemeTemplateVersion[]

  @@map("themes")
}

/// Un fișier CSS al unei teme (ACP → Aspect → CSS), compilat după setări în ordinea `position`. `content` e deja
/// sanitizat. `custom.css` e și CSS-ul din editorul vizual (nu se poate redenumi sau șterge).
model ThemeCssFile {
  id        Int      @id @default(autoincrement())
  themeId   Int
  name      String
  position  Int      @default(0)
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theme    Theme             @relation(fields: [themeId], references: [id], onDelete: Cascade)
  versions ThemeCssVersion[]

  @@unique([themeId, name])
  @@index([themeId, position])
  @@map("theme_css_files")
}

/// O versiune a unui fișier CSS (`create`, `save`, `restore`, `publish`, `migrate`, `import`); prima e originalul.
model ThemeCssVersion {
  id         Int      @id @default(autoincrement())
  fileId     Int
  content    String
  action     String
  authorId   String?
  authorName String   @default("")
  createdAt  DateTime @default(now())

  file ThemeCssFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId, id])
  @@map("theme_css_versions")
}

/// Șablonul modificat al unei teme (ACP → Aspect → Șabloane). Fără rând, se folosește șablonul implicit din cod.
/// `baseVersion`/`baseSource`: șablonul implicit de la care a pornit (o versiune nouă în cod = „necesită revizuire”).
model ThemeTemplate {
  id          Int      @id @default(autoincrement())
  themeId     Int
  key         String
  source      String
  baseVersion Int
  baseSource  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, key])
  @@map("theme_templates")
}

/// Istoricul unui șablon pe o temă (`save`, `restore`, `revert`, `import`); rămâne și după „Revino la original”.
model ThemeTemplateVersion {
  id         Int      @id @default(autoincrement())
  themeId    Int
  key        String
  source     String
  action     String
  authorId   String?
  authorName String   @default("")
  createdAt  DateTime @default(now())

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId, key, id])
  @@map("theme_template_versions")
}

/// Un widget pus pe o pagină (`index`, `forum`, `topic`), într-o zonă (`top`, `bottom`, `sidebar`). `groups` gol = toți.
model WidgetPlacement {
  id       Int    @id @default(autoincrement())
  page     String
  zone     String
  position Int    @default(0)
  type     String
  config   Json   @default("{}")
  groups   Int[]

  @@index([page, zone, position])
  @@map("widget_placements")
}

/// Membrii unei camere private de chat.
model ChatRoomMember {
  channelId   Int
  userId      String
  invitedById String?
  joinedAt    DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation("ChatRoomMember", fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
  @@map("chat_room_members")
}

/// O reacție la un mesaj de chat (unică pe user și pe reacție).
model ChatMessageReaction {
  messageId  Int
  userId     String
  reactionId Int
  createdAt  DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, reactionId])
  @@map("chat_message_reactions")
}

/// Anunțurile globale din chat (în toate camerele), până la `expiresAt`.
model ChatAnnouncement {
  id          Int       @id @default(autoincrement())
  body        String
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([expiresAt])
  @@map("chat_announcements")
}

// ─── Chat Pro (aplicația premium, specul 2026-10-10-chat-pro) ────────────────

/// Profilul de chat al unui membru: preferințele (JSON normalizat de modul), porecla, insignele alese, favoritele.
model ChatProProfile {
  userId             String   @id
  prefs              Json     @default("{}")
  /// Porecla din chat (gol = numele de pe forum); unică după normalizare, nu poate fi numele altui membru.
  nickname           String?
  nicknameNormalized String?  @unique
  /// Cel mult 2 badge-uri obținute, afișate lângă nume.
  badgeIds           Int[]    @default([])
  /// Emoticoanele favorite (codurile, fără `:`) și GIF-urile favorite (`[{ id, url, preview, width, height }]`).
  emoteFavorites     String[] @default([])
  gifFavorites       Json     @default("[]")
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_pro_profiles")
}

/// Mesajele numărate ale unui membru într-o zi (`day` = YYYY-MM-DD în fusul orar al site-ului): clasamentul și statisticile.
model ChatProDailyStat {
  userId   String
  day      String
  messages Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
  @@map("chat_pro_daily_stats")
}

/// Câștigătorul unei perioade a clasamentului (`periodStart` – `periodEnd`, zile YYYY-MM-DD, inclusiv).
model ChatProWinner {
  id          Int      @id @default(autoincrement())
  periodStart String   @unique
  periodEnd   String
  userId      String?
  messages    Int      @default(0)
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("chat_pro_winners")
}

/// Un element al barei de anunțuri de deasupra conversației (text, buton opțional, program, grupuri).
model ChatProBarItem {
  id        Int       @id @default(autoincrement())
  text      String
  ctaLabel  String    @default("")
  ctaUrl    String    @default("")
  startsAt  DateTime?
  endsAt    DateTime?
  /// Grupurile care îl văd (gol = toți).
  groupIds  Int[]     @default([])
  enabled   Boolean   @default(true)
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("chat_pro_bar_items")
}

/// Un pachet (categorie) de emoticoane încărcate de admini.
model ChatEmotePack {
  id        Int      @id @default(autoincrement())
  name      String
  position  Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  emotes ChatEmote[]

  @@map("chat_emote_packs")
}

/// Un emoticon: codul `:cod:` (unic), imaginea (atașamentul `chat_pro.emote`) și dimensiunile ei.
model ChatEmote {
  id           Int      @id @default(autoincrement())
  packId       Int
  code         String   @unique
  attachmentId String
  width        Int
  height       Int
  animated     Boolean  @default(false)
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  pack ChatEmotePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, position])
  @@map("chat_emotes")
}

/// Cache-ul traducerilor de conținut: `hash` = sha256(provider + limba țintă + text).
model TranslationCache {
  hash      String   @id
  target    String
  text      String
  provider  String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("translation_cache")
}

// ─── Pluginuri (etapa 6 §2; designul: docs/superpowers/specs/2026-10-06-pluginuri.md) ───

/// Un plugin instalat. Arhiva (`package`) e sursa de adevăr: fiecare proces o dezarhivează în `GCS_PLUGINS_DIR`.
/// `status`: `installed` sau `removed_kept_data` (dezinstalat cu păstrarea datelor: schema, rolul DB și setările).
/// `dbRole` / `dbPassword`: rolul PostgreSQL dedicat, cu care rulează SQL-ul pluginului (doar în schema lui).
model Plugin {
  key                 String                  @id
  name                String
  version             String
  enabled             Boolean                 @default(false)
  status              String                  @default("installed")
  signed              Boolean                 @default(false)
  signatureKeyId      String?
  capabilities        String[]
  manifest            Json
  settings            Json                    @default("{}")
  package             Bytes?
  packageSha256       String?
  dbRole              String?
  dbPassword          String?
  migrations          String[]
  /// `admin`, `auto` (eșecuri la rând) sau `cli` (dezactivare din consolă), când `enabled = false`.
  disabledReason      String?
  consecutiveFailures Int                     @default(0)
  lastError           String?
  lastErrorAt         DateTime?
  installedAt         DateTime                @default(now())
  installedById       String?
  updatedAt           DateTime                @updatedAt
  hookSettings        PluginHookSetting[]
  logs                PluginLog[]
  media               PluginMedia[]
  appearances         MemberAppearance[]
  appearanceStyles    PluginAppearanceStyle[]

  @@map("plugins")
}

/// O arhivă încărcată din ACP, în așteptarea confirmării (ștearsă după o oră).
model PluginUpload {
  id        String   @id @default(cuid())
  actorId   String?
  fileName  String
  data      Bytes
  sha256    String
  report    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("plugin_uploads")
}

/// Jurnalul unui plugin: erorile hook-urilor și mesajele lui (`ctx.log`), ultimele câteva sute.
model PluginLog {
  id         Int      @id @default(autoincrement())
  pluginKey  String
  level      String
  hook       String?
  message    String
  durationMs Int?
  createdAt  DateTime @default(now())
  plugin     Plugin   @relation(fields: [pluginKey], references: [key], onDelete: Cascade)

  @@index([pluginKey, id])
  @@map("plugin_logs")
}

/// ACP → Sistem → Hook-uri: un hook al unui plugin oprit sau cu altă prioritate decât cea din manifest.
model PluginHookSetting {
  pluginKey String
  hook      String
  enabled   Boolean @default(true)
  priority  Int?
  plugin    Plugin  @relation(fields: [pluginKey], references: [key], onDelete: Cascade)

  @@id([pluginKey, hook])
  @@map("plugin_hook_settings")
}

/// Un fișier media al unui plugin (capabilitatea `media`, Studio VIP): tipul verificat din conținut, imaginile recodate.
/// `pending` până când pluginul îl păstrează (`ctx.media.keep`); cele nepăstrate se șterg după 6 ore.
model PluginMedia {
  id         String   @id @default(cuid())
  pluginKey  String
  /// `image`, `video` sau `audio`.
  kind       String
  mime       String
  ext        String
  size       Int
  width      Int?
  height     Int?
  durationMs Int?
  storageKey String   @unique
  /// `pending` sau `kept`.
  status     String   @default("pending")
  uploadedBy String?
  createdAt  DateTime @default(now())
  plugin     Plugin   @relation(fields: [pluginKey], references: [key], onDelete: Cascade)

  @@index([pluginKey, status, createdAt])
  @@map("plugin_media")
}

/// Un stil CSS scris de un admin în ACP-ul unui plugin cu `appearance` (stil de nume sau de banner). `css` e sursa,
/// verificată la salvare; nucleul o compilează în `/gcs-names.css`, închisă pe clasa stilului și pe numele membrilor
/// care l-au ales (`customStyle.ts`).
model PluginAppearanceStyle {
  pluginKey String
  /// `name` sau `banner`.
  kind      String
  key       String
  css       String
  updatedBy String?
  updatedAt DateTime @updatedAt
  plugin    Plugin   @relation(fields: [pluginKey], references: [key], onDelete: Cascade)

  @@id([pluginKey, kind, key])
  @@map("plugin_appearance_styles")
}

/// Aspectul unui membru publicat de un plugin (capabilitatea `appearance`): JSON validat de nucleu
/// (`parseMemberAppearance`), randat în nume, avatare, postbit, hover card și profil.
model MemberAppearance {
  pluginKey String
  userId    String
  data      Json
  updatedAt DateTime @updatedAt
  plugin    Plugin   @relation(fields: [pluginKey], references: [key], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pluginKey, userId])
  @@index([userId])
  @@map("member_appearances")
}

// ─── Importul din altă platformă (specul importului, etapa 6) ────────────────

enum ImportStatus {
  DRAFT
  READY
  QUEUED
  RUNNING
  PAUSED
  CANCELLED
  FAILED
  DONE
}

/// Un import configurat în ACP → Sistem → Conversii. `config` nu conține secrete; `secret` = parola bazei vechi,
/// criptată (`sealSecret`). `steps`: progresul și checkpoint-ul (cursorul) fiecărui pas.
model ImportJob {
  id          String       @id @default(cuid())
  /// Schema detectată (`core-schema`, `prefixed-schema`) și cheia hărții de id-uri (schema + host-ul vechi).
  source      String       @default("")
  mapKey      String       @default("")
  status      ImportStatus @default(DRAFT)
  dryRun      Boolean      @default(false)
  config      Json         @default("{}")
  secret      String?
  detected    Json?
  steps       Json         @default("[]")
  currentStep String?
  /// Cererea de `pause` sau `cancel`, citită de worker între loturi.
  control     String?
  error       String?
  createdById String?
  heartbeatAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  logs ImportLog[]

  @@index([status])
  @@map("import_jobs")
}

/// Legătura id vechi → id nou, pe tip (`member`, `topic`, `post`…). Rulările de pe aceeași sursă o refolosesc.
model ImportMap {
  source   String
  type     String
  sourceId String
  targetId String

  @@id([source, type, sourceId])
  @@index([type, targetId])
  @@map("import_map")
}

/// Jurnalul unui import (`info`, `warn`, `error`), pe pași.
model ImportLog {
  id        Int      @id @default(autoincrement())
  jobId     String
  step      String
  level     String
  message   String
  sourceId  String?
  createdAt DateTime @default(now())

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, id])
  @@map("import_logs")
}

/// O portare de plugin (ACP → Sistem → Conversii → Portare plugin): arhiva sursă până la conversie, apoi raportul,
/// rezultatul (`.zip` cu folderul generat, `ORIGINAL/` și `PORTING.md`) și pachetul instalabil. Ștearsă după o zi.
model PluginPort {
  id          String    @id @default(cuid())
  actorId     String?
  fileName    String
  /// Formatul detectat: `app-json`, `plugin-xml` sau `addon-json`.
  format      String
  sourceName  String
  sha256      String
  /// Metadatele, licența și numerele pe tipuri (fără cod), afișate înaintea confirmării.
  analysis    Json
  /// Arhiva încărcată, ștearsă după conversie.
  source      Bytes?
  /// Temeiul confirmării dreptului de a modifica și folosi pluginul: `author`, `consent` sau `license`.
  rightsBasis String?
  confirmedAt DateTime?
  pluginKey   String?
  report      Json?
  result      Bytes?
  package     Bytes?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@map("plugin_ports")
}

// ─── Servere de joc (etapa Gaming, specul 2026-10-07-servere) ─────────────────

/// Un server de joc afișat pe `/servers`. `game` = cheia din catalogul jocurilor (`cs16`, `cs2`, `minecraft`,
/// `minecraft_bedrock`). `groups` gol = îl vede oricine are `servers.view`; altfel doar aceste grupuri.
model GameServer {
  id          Int      @id @default(autoincrement())
  game        String
  host        String
  port        Int
  /// Portul de interogare, dacă diferă de portul jocului.
  queryPort   Int?
  name        String
  slug        String
  position    Int      @default(0)
  /// Atașamentul bannerului (`servers.banner`, legat de id-ul serverului).
  bannerId    String?
  /// Text simplu (rândurile noi se păstrează), max 2000 de caractere.
  description String   @default("")
  forumId     Int?
  enabled     Boolean  @default(true)
  groups      Int[]    @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Puntea (specul 2026-10-08-servere-bridge §4.1): modul identităților (`steam` / `mixed`), identitățile pe nume,
  /// serverul de meciuri mix, ultimul heartbeat și pluginul raportat.
  identityMode     String    @default("mixed")
  nameIds          Boolean   @default(false)
  isMix            Boolean   @default(false)
  bridgeSeenAt     DateTime?
  bridgePlugin     String?
  /// Modulele opționale ale pluginului (specul 2026-10-08-servere-plugin-v2 §1.2), implicit oprite: pluginul doar
  /// colectează date. Adminii din GCS, sancțiunile, VIP-ul, ready-up-ul mix și comenzile de admin GCS.
  manageAdmins     Boolean   @default(false)
  enforceSanctions Boolean   @default(false)
  manageVip        Boolean   @default(false)
  mixReady         Boolean   @default(false)
  adminCommands    Boolean   @default(false)

  forum        Forum?                 @relation(fields: [forumId], references: [id], onDelete: SetNull)
  admins       GameServerAdmin[]
  snapshots    ServerSnapshot[]
  bridgeKeys   GameServerKey[]
  sessions     GameSession[]
  playerStats  GamePlayerStat[]
  gameAdmins   GameAdmin[]
  sanctions    GameSanction[]
  vipMappings  GameVipMapping[]
  matches      GameMatch[]
  adminActions GameAdminAction[]
  tickets      GameTicket[]
  lastPlayers  GamePlayer[]           @relation("GamePlayerLastServer")
  enrollments  GameServerEnrollment[]
  tv           GameServerTv?
  demos        GameMatchDemo[]

  @@unique([game, host, port])
  @@index([enabled, position])
  @@map("game_servers")
}

/// Adminii unui server de joc (membri GCS), în ordinea afișată.
model GameServerAdmin {
  serverId Int
  userId   String
  position Int    @default(0)

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([serverId, userId])
  @@index([userId])
  @@map("game_server_admins")
}

/// Istoricul interogărilor: un rând brut pe interogare (`hourly = false`), agregat pe oră după 7 zile (`hourly = true`).
/// `samples` e greutatea rândului (multiplicatorul backoff-ului), `onlineSamples` partea ei „online”: uptime-ul =
/// Σ onlineSamples / Σ samples, ponderat cu timpul.
model ServerSnapshot {
  id            BigInt   @id @default(autoincrement())
  serverId      Int
  at            DateTime @default(now())
  hourly        Boolean  @default(false)
  online        Boolean
  players       Int      @default(0)
  peak          Int      @default(0)
  maxPlayers    Int      @default(0)
  map           String?
  ping          Int?
  samples       Int      @default(1)
  onlineSamples Int      @default(0)

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, at])
  @@index([hourly, at])
  @@map("server_snapshots")
}

// ─── Clanuri (etapa Gaming, specul 2026-10-08-clanuri) ───────────────────────

/// Starea unui clan: în așteptarea aprobării staff-ului, activ sau arhivat (fără activitate sau de staff).
enum ClanStatus {
  PENDING
  ACTIVE
  ARCHIVED
}

enum ClanRole {
  LEADER
  OFFICER
  MEMBER
}

/// Cum se intră în clan: liber, cu cerere aprobată sau doar cu invitație.
enum ClanJoinMode {
  OPEN
  REQUEST
  INVITE
}

enum ClanRequestKind {
  REQUEST
  INVITE
}

enum ClanRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

/// Un clan. `tagNormalized` / `nameNormalized` (litere mari / mici, fără diacritice) țin unicitatea. `forumId` = forumul
/// privat (drepturile vin din apartenență, nu din grupuri). `memberLimit` gol = limita grupurilor liderului.
model Clan {
  id              Int          @id @default(autoincrement())
  tag             String
  tagNormalized   String       @unique
  name            String
  nameNormalized  String       @unique
  slug            String
  status          ClanStatus   @default(PENDING)
  locked          Boolean      @default(false)
  lockReason      String?
  joinMode        ClanJoinMode @default(REQUEST)
  /// Documentul editorului (profilul `clanDescription`) și HTML-ul sanitizat de renderer.
  descriptionJson Json?
  descriptionHtml String       @default("")
  /// Atașamentele logo-ului și bannerului (`clans.logo` / `clans.banner`, legate de id-ul clanului).
  logoId          String?
  bannerId        String?
  color           String       @default("#D62839")
  color2          String       @default("#1B1E26")
  /// `{ discord?, steam?, website?, youtube?, twitch? }`, adrese https validate.
  links           Json         @default("{}")
  /// Drepturile date ofițerilor de lider (`members`, `invite`, `requests`, `edit`, `forum`, `events`).
  officerRights   String[]     @default([])
  memberLimit     Int?
  membersCount    Int          @default(0)
  score           Int          @default(0)
  /// Locul în clasament (doar clanurile active); `scoreParts` = valorile formulei.
  rank            Int?
  scoreParts      Json         @default("{}")
  scoredAt        DateTime?
  forumId         Int?         @unique
  /// Liderul a cerut forumul privat la creare (opțiunea „opțional”): se creează la aprobare.
  forumRequested  Boolean      @default(false)
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  lastActivityAt  DateTime     @default(now())
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  forum     Forum?        @relation(fields: [forumId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("ClanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   ClanMember[]
  requests  ClanRequest[]

  @@index([status, rank])
  @@index([status, membersCount])
  @@index([status, createdAt])
  @@map("clans")
}

/// Membrii unui clan. Un singur lider pe clan (indexul unic parțial `clan_members_one_leader`, din migrare).
model ClanMember {
  clanId   Int
  userId   String
  role     ClanRole @default(MEMBER)
  joinedAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clanId, userId])
  @@index([userId])
  @@map("clan_members")
}

/// Cererile de intrare (`REQUEST`, `userId` = candidatul) și invitațiile (`INVITE`, `userId` = invitatul). O singură
/// cerere / invitație în așteptare pe (clan, membru, fel): indexul unic parțial `clan_requests_one_pending`, din migrare.
model ClanRequest {
  id          Int               @id @default(autoincrement())
  clanId      Int
  userId      String
  kind        ClanRequestKind
  status      ClanRequestStatus @default(PENDING)
  message     String            @default("")
  invitedById String?
  decidedById String?
  createdAt   DateTime          @default(now())
  expiresAt   DateTime
  decidedAt   DateTime?

  clan      Clan  @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user      User  @relation("ClanRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("ClanRequestInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([clanId, status])
  @@index([userId, status])
  @@map("clan_requests")
}

// ─── Puntea cu serverele de joc (specul 2026-10-08-servere-bridge) ───────────

/// Tipul unei identități de joc: Steam (dovedit), non-Steam (ID-ul emulatorului) sau numele.
enum GamePlayerKind {
  STEAM
  NONSTEAM
  NAME
}

enum GameTrust {
  HIGH
  MEDIUM
  LOW
}

/// Cum a fost legată identitatea de un membru: contul Steam conectat, codul din joc sau staff-ul.
enum GameLinkSource {
  STEAM
  CODE
  STAFF
}

/// Cine primește drepturile unui admin de server: un membru, o identitate brută sau un nume cu parolă.
enum GameAdminSubject {
  USER
  PLAYER
  NAME
}

enum GameSanctionType {
  BAN
  MUTE
  GAG
}

enum GameSanctionScope {
  SERVER
  GLOBAL
}

enum GameSanctionSource {
  SITE
  GAME
}

enum GameMatchStatus {
  WARMUP
  LIVE
  HALFTIME
  ENDED
  ABORTED
}

/// Contestația unui ban, reclamația unui cheater sau a unui admin.
enum GameTicketKind {
  APPEAL
  CHEATER
  ADMIN
}

enum GameTicketStatus {
  OPEN
  REVIEW
  ACCEPTED
  REJECTED
  CLOSED
}

enum GameTicketMessageKind {
  MESSAGE
  STATUS
  ASSIGN
}

enum GameMapSource {
  UPLOAD
  TEMPLATE
}

/// Cheile API ale unui server. `signingKey` = hash-ul secretului (SHA-256 hex), sigilat cu `GCS_SECRET`; secretul nu e
/// păstrat nicăieri. `expiresAt` = perioada de grație a unei chei rotite.
model GameServerKey {
  id          Int       @id @default(autoincrement())
  serverId    Int
  keyId       String    @unique
  signingKey  String
  label       String    @default("")
  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  lastIp      String?
  revokedAt   DateTime?
  expiresAt   DateTime?

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("game_server_keys")
}

enum GameEnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// O înrolare automată (specul 2026-10-08-servere-plugin-v2 §5): un server necunoscut cu pluginul general cere o cheie.
/// `ref` = referința aleatorie dată doar pluginului; `secretHash` = SHA-256(secretul generat de plugin). `ip` = IP-ul
/// sursei cererii (nu o adresă raportată); `check` = rezultatul interogării acelui IP:port. Cheia se creează abia la
/// livrare (`keyId`), o singură dată.
model GameServerEnrollment {
  id          Int                  @id @default(autoincrement())
  ref         String               @unique
  secretHash  String               @unique
  game        String
  ip          String
  port        Int
  hostname    String               @default("")
  map         String?
  players     Int                  @default(0)
  maxPlayers  Int                  @default(0)
  plugin      String               @default("")
  status      GameEnrollmentStatus @default(PENDING)
  check       Json?
  checkedAt   DateTime?
  serverId    Int?
  decidedById String?
  decidedAt   DateTime?
  keyId       String?
  deliveredAt DateTime?
  deliveries  Int                  @default(0)
  createdAt   DateTime             @default(now())
  lastSeenAt  DateTime             @default(now())
  expiresAt   DateTime

  server GameServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([ip])
  @@map("game_server_enrollments")
}

/// O identitate de joc (`kind`, `value`), cu sau fără cont pe site. `value`: SteamID64 (`STEAM`), ID-ul canonic al
/// emulatorului (`NONSTEAM`) sau numele normalizat (`NAME`).
model GamePlayer {
  id           Int             @id @default(autoincrement())
  kind         GamePlayerKind
  value        String
  trust        GameTrust
  userId       String?
  linkSource   GameLinkSource?
  linkedAt     DateTime?
  /// Ultimul nume văzut (curățat, max 32).
  name         String          @default("")
  firstSeenAt  DateTime        @default(now())
  lastSeenAt   DateTime        @default(now())
  lastServerId Int?

  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  lastServer   GameServer?       @relation("GamePlayerLastServer", fields: [lastServerId], references: [id], onDelete: SetNull)
  linkCodes    GameLinkCode[]
  sessions     GameSession[]
  stats        GamePlayerStat[]
  weaponStats  GameWeaponStat[]
  mapStats     GameMapStat[]
  adminEntries GameAdmin[]
  sanctions    GameSanction[]
  matches      GameMatchPlayer[]
  rating       GameRating?

  @@unique([kind, value])
  @@index([userId])
  @@index([lastSeenAt])
  @@map("game_players")
}

/// Codurile de legare din joc (`/gcs COD`): doar hash-ul codului (SHA-256), valabil 10 minute, o singură folosire.
model GameLinkCode {
  id        Int       @id @default(autoincrement())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  playerId  Int?
  createdAt DateTime  @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  player GamePlayer? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("game_link_codes")
}

/// Conectările pe servere. `disconnectedAt` gol = online; `adminId` = adminul recunoscut în sesiune.
model GameSession {
  id             BigInt    @id @default(autoincrement())
  serverId       Int
  playerId       Int
  adminId        Int?
  name           String    @default("")
  ip             String?
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  seconds        Int       @default(0)
  /// Flag-urile de admin raportate de server (litere AMXX normalizate), din sistemul de admini al serverului.
  adminFlags     String?

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  player GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  admin  GameAdmin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([serverId, disconnectedAt])
  @@index([playerId, connectedAt])
  @@index([adminId, connectedAt])
  @@map("game_sessions")
}

/// Statisticile unui jucător pe un server. `score` = ucideri − decese − ucideri în echipă; `rank` = locul pe server
/// (jobul `servers.bridge.ranks`), gol sub timpul minim de joc.
model GamePlayerStat {
  playerId   Int
  serverId   Int
  kills      Int      @default(0)
  deaths     Int      @default(0)
  headshots  Int      @default(0)
  assists    Int      @default(0)
  teamkills  Int      @default(0)
  suicides   Int      @default(0)
  shots      Int      @default(0)
  hits       Int      @default(0)
  damage     Int      @default(0)
  playtime   Int      @default(0)
  rounds     Int      @default(0)
  roundsWon  Int      @default(0)
  score      Int      @default(0)
  rank       Int?
  lastSeenAt DateTime @default(now())

  player GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([playerId, serverId])
  @@index([serverId, rank])
  @@map("game_player_stats")
}

model GameWeaponStat {
  playerId  Int
  serverId  Int
  weapon    String
  kills     Int    @default(0)
  deaths    Int    @default(0)
  headshots Int    @default(0)
  shots     Int    @default(0)
  hits      Int    @default(0)
  damage    Int    @default(0)

  player GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, serverId, weapon])
  @@map("game_weapon_stats")
}

model GameMapStat {
  playerId  Int
  serverId  Int
  map       String
  kills     Int    @default(0)
  deaths    Int    @default(0)
  headshots Int    @default(0)
  playtime  Int    @default(0)
  rounds    Int    @default(0)
  roundsWon Int    @default(0)

  player GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, serverId, map])
  @@map("game_map_stats")
}

/// Id-urile evenimentelor aplicate (idempotența), păstrate 14 zile.
model GameBridgeEvent {
  serverId  Int
  eventId   String
  createdAt DateTime @default(now())

  @@id([serverId, eventId])
  @@index([createdAt])
  @@map("game_bridge_events")
}

/// Presetările de admin (flag-uri AMXX + imunitate), editabile.
model GameAdminPreset {
  id       Int    @id @default(autoincrement())
  name     String
  flags    String
  immunity Int    @default(0)
  position Int    @default(0)

  admins GameAdmin[]

  @@map("game_admin_presets")
}

/// Un admin de server. `serverId` gol = toate serverele; `flags` / `immunity` goale = ale presetului. Subiectul `NAME`
/// are doar sarea și verificatorul parolei (`hex(SHA-256(salt:parolă))`), niciodată parola.
model GameAdmin {
  id               Int              @id @default(autoincrement())
  subject          GameAdminSubject
  userId           String?
  playerId         Int?
  name             String?
  nameNormalized   String?
  passwordSalt     String?
  passwordVerifier String?
  serverId         Int?
  presetId         Int?
  flags            String?
  immunity         Int?
  allowNonSteam    Boolean          @default(false)
  note             String           @default("")
  expiresAt        DateTime?
  /// Expirarea a fost deja scrisă în jurnal (jobul de curățenie).
  expiredLoggedAt  DateTime?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  player   GamePlayer?      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  server   GameServer?      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  preset   GameAdminPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  sessions GameSession[]

  @@index([userId])
  @@index([playerId])
  @@index([serverId])
  @@index([nameNormalized])
  @@map("game_admins")
}

/// Bannurile și comunicațiile (mute vocal / gag chat). Activă = `unbannedAt` gol și (`expiresAt` gol sau în viitor);
/// se aplică pe serverul S = `GLOBAL` sau `serverId = S`. `revision` vine din secvența `game_sync_revision` și se
/// schimbă la orice modificare (sincronizarea incrementală a pluginurilor).
model GameSanction {
  id             Int                @id @default(autoincrement())
  type           GameSanctionType
  scope          GameSanctionScope
  serverId       Int?
  playerId       Int?
  targetKind     GamePlayerKind?
  targetValue    String?
  ip             String?
  name           String?
  reason         String
  createdAt      DateTime           @default(now())
  expiresAt      DateTime?
  adminUserId    String?
  adminPlayerId  Int?
  adminName      String             @default("")
  source         GameSanctionSource
  unbannedAt     DateTime?
  unbannedById   String?
  unbannedByName String?
  unbanReason    String?
  /// `[{ url }]`, max 10 adrese https.
  evidence       Json               @default("[]")
  revision       BigInt             @default(dbgenerated("nextval('game_sync_revision'::regclass)"))
  updatedAt      DateTime           @updatedAt

  server  GameServer?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  player  GamePlayer?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
  tickets GameTicket[]

  @@index([revision])
  @@index([playerId])
  @@index([targetKind, targetValue])
  @@index([ip])
  @@index([type, expiresAt])
  @@map("game_sanctions")
}

/// Jurnalul acțiunilor din joc (ban, kick, slay, mute…), raportate de plugin.
model GameAdminAction {
  id             Int      @id @default(autoincrement())
  serverId       Int
  adminPlayerId  Int?
  adminUserId    String?
  adminId        Int?
  adminName      String   @default("")
  action         String
  targetPlayerId Int?
  targetName     String   @default("")
  reason         String   @default("")
  details        Json?
  sanctionId     Int?
  at             DateTime @default(now())

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, at])
  @@index([adminId, at])
  @@index([adminUserId, at])
  @@map("game_admin_actions")
}

/// VIP pe servere: grupul VIP pornit pe server, cu flag-urile lui (implicit `b`, rezervarea).
model GameVipMapping {
  id       Int     @id @default(autoincrement())
  serverId Int
  groupId  Int
  enabled  Boolean @default(true)
  flags    String  @default("b")

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  group  Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([serverId, groupId])
  @@map("game_vip_mappings")
}

/// Un meci mix (5v5). `externalId` = id-ul dat de plugin, unic pe server; `winner` = `A` / `B` / `DRAW` la final;
/// `rated` = ELO-ul a fost aplicat.
model GameMatch {
  id         Int             @id @default(autoincrement())
  serverId   Int
  externalId String
  map        String          @default("")
  status     GameMatchStatus @default(WARMUP)
  teamAName  String          @default("")
  teamBName  String          @default("")
  scoreA     Int             @default(0)
  scoreB     Int             @default(0)
  round      Int             @default(0)
  winner     String?
  startedAt  DateTime        @default(now())
  liveAt     DateTime?
  endedAt    DateTime?
  rated      Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  server  GameServer        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  players GameMatchPlayer[]
  rounds  GameMatchRound[]
  demos   GameMatchDemo[]

  @@unique([serverId, externalId])
  @@index([serverId, startedAt])
  @@index([status, endedAt])
  @@map("game_matches")
}

model GameMatchPlayer {
  matchId   Int
  playerId  Int
  team      String
  name      String @default("")
  kills     Int    @default(0)
  deaths    Int    @default(0)
  assists   Int    @default(0)
  headshots Int    @default(0)
  damage    Int    @default(0)
  mvps      Int    @default(0)
  eloBefore Int?
  eloAfter  Int?

  match  GameMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([matchId, playerId])
  @@index([playerId])
  @@map("game_match_players")
}

model GameMatchRound {
  matchId Int
  number  Int
  winner  String
  scoreA  Int
  scoreB  Int
  reason  String   @default("")
  endedAt DateTime @default(now())

  match GameMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, number])
  @@map("game_match_rounds")
}

/// HLTV / GOTV și demo-urile unui server (specul 2026-10-08-servere-hltv §2.1); lipsa rândului = totul oprit. Secretele
/// (`secret`, `privateKey`, `rconPassword`) sunt sigilate cu `sealSecret` și nu se arată niciodată înapoi.
model GameServerTv {
  serverId      Int       @id
  address       String?
  delay         Int?
  source        String    @default("none")
  host          String?
  port          Int?
  username      String?
  secret        String?
  privateKey    String?
  remoteDir     String    @default("/")
  tlsInsecure   Boolean   @default(false)
  hostKey       String?
  httpTemplate  String?
  namePrefix    String    @default("")
  timeZone      String    @default("UTC")
  record        Boolean   @default(false)
  rconPassword  String?
  lastFetchAt   DateTime?
  lastFetchOk   Boolean?
  lastFetchCode String?
  lastFetchInfo Json?
  lastRcon      Json?
  updatedAt     DateTime  @updatedAt

  server GameServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@map("game_server_tv")
}

/// Starea unui demo (specul 2026-10-08-servere-hltv §2.2).
enum GameDemoStatus {
  WAITING
  FETCHING
  AVAILABLE
  NOT_FOUND
  FAILED
  EXPIRED
}

/// Un fișier demo al unui meci mix (un meci poate avea mai multe părți). Fișierul stă privat în store-ul platformei
/// (`storageKey`), servit doar prin ruta descărcării, cu drepturile verificate. Rândurile rămase fără meci se curăță
/// împreună cu fișierul lor.
model GameMatchDemo {
  id            Int            @id @default(autoincrement())
  matchId       Int?
  serverId      Int?
  part          Int            @default(1)
  status        GameDemoStatus @default(WAITING)
  source        String
  remoteName    String?
  fileName      String
  storageKey    String?
  encoding      String         @default("identity")
  size          Int?
  storedSize    Int?
  sha256        String?
  downloads     Int            @default(0)
  attempts      Int            @default(0)
  nextAttemptAt DateTime?
  error         String?
  chunkSize     Int?
  received      Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  availableAt   DateTime?
  expiresAt     DateTime?

  match  GameMatch?  @relation(fields: [matchId], references: [id], onDelete: SetNull)
  server GameServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@unique([matchId, part])
  @@index([status, nextAttemptAt])
  @@index([status, availableAt])
  @@index([serverId, createdAt])
  @@map("game_match_demos")
}

/// ELO-ul unei identități (meciurile mix) și totalurile ei.
model GameRating {
  playerId  Int      @id
  elo       Int
  matches   Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  peak      Int
  updatedAt DateTime @updatedAt

  player GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([elo])
  @@map("game_ratings")
}

/// Contestațiile bannurilor și reclamațiile (cheater / admin). Conținutul e documentul editorului, randat ca postările.
model GameTicket {
  id             Int              @id @default(autoincrement())
  kind           GameTicketKind
  status         GameTicketStatus @default(OPEN)
  authorId       String
  serverId       Int?
  sanctionId     Int?
  targetPlayerId Int?
  targetUserId   String?
  targetAdminId  Int?
  targetName     String           @default("")
  title          String
  contentJson    Json
  contentHtml    String
  /// `[{ url }]`, max 10 adrese https.
  evidence       Json             @default("[]")
  assigneeId     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lastActivityAt DateTime         @default(now())
  closedAt       DateTime?

  author   User                @relation("GameTicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  server   GameServer?         @relation(fields: [serverId], references: [id], onDelete: SetNull)
  sanction GameSanction?       @relation(fields: [sanctionId], references: [id], onDelete: SetNull)
  messages GameTicketMessage[]

  @@index([status, lastActivityAt])
  @@index([authorId, kind, status])
  @@index([sanctionId])
  @@index([serverId, status])
  @@map("game_tickets")
}

model GameTicketMessage {
  id          Int                   @id @default(autoincrement())
  ticketId    Int
  authorId    String?
  kind        GameTicketMessageKind @default(MESSAGE)
  contentJson Json?
  contentHtml String                @default("")
  internal    Boolean               @default(false)
  data        Json?
  createdAt   DateTime              @default(now())

  ticket GameTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("game_ticket_messages")
}

/// Catalogul hărților pe joc. `imageId` = atașamentul `servers.map` (public); fără el se arată arta generică.
model GameMap {
  id          Int            @id @default(autoincrement())
  game        String
  name        String
  imageId     String?
  source      GameMapSource?
  fetchedAt   DateTime?
  fetchError  String?
  attempts    Int            @default(0)
  nextFetchAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([game, name])
  @@index([imageId, nextFetchAt])
  @@map("game_maps")
}

// ─── Ștergerea și unirea conturilor (specul 2026-10-09-stergere-unire-membri) ─

enum MemberRemovalKind {
  DELETE
  MERGE
}

/// Ce se întâmplă cu conținutul public la ștergere: rămâne ca „Membru șters” sau se șterge și el.
enum MemberRemovalMode {
  KEEP_CONTENT
  DELETE_CONTENT
}

/// Cine a cerut operația: staff-ul (ACP) sau membrul însuși (Setări → Cont).
enum MemberRemovalSource {
  ACP
  SELF
}

/// `SCHEDULED` = cererea membrului, în perioada de răzgândire (`runAfter`); `QUEUED` / `RUNNING` = jobul; `FAILED` = de reluat.
enum MemberRemovalStatus {
  SCHEDULED
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

/// O ștergere sau o unire de conturi (ACP → Membri → Cereri GDPR). `userId` / `targetId` nu au chei străine: rândul rămâne
/// după ștergerea userului, cu numele vechi (singura dată personală păstrată, ca în jurnal). `steps` = progresul pe pașii
/// handler-elor (`{ [cheie]: { done, processed } }`). Un singur rând activ pe `userId` (index unic parțial, din migrare).
model MemberRemoval {
  id            String              @id @default(cuid())
  kind          MemberRemovalKind
  status        MemberRemovalStatus
  source        MemberRemovalSource @default(ACP)
  mode          MemberRemovalMode   @default(KEEP_CONTENT)
  /// Ștergerea: mesajele private trimise rămân în conversațiile celorlalți (ca „Membru șters”).
  keepMessages  Boolean             @default(false)
  userId        String
  userName      String
  targetId      String?
  targetName    String?
  requestedById String?
  /// Cererea membrului: sfârșitul perioadei de răzgândire.
  runAfter      DateTime?
  steps         Json                @default("{}")
  currentStep   String?
  error         String?
  attempts      Int                 @default(0)
  heartbeatAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, runAfter])
  @@index([userId])
  @@index([createdAt])
  @@map("member_removals")
}
