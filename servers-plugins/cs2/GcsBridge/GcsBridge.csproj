<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GCS Server Bridge pentru Counter-Strike 2 (CounterStrikeSharp, .NET 8). Licența: MIT (vezi LICENSE).
    Compilare: dotnet build -c Release (vezi servers-plugins/README.md). Rezultatul: bin/Release/net8.0/GcsBridge.dll,
    copiat în addons/counterstrikesharp/plugins/GcsBridge/.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GcsBridge</AssemblyName>
    <RootNamespace>Gcs.Bridge</RootNamespace>
    <Version>1.1.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Build reproductibil, fără căile locale ale mașinii în DLL (folderul proiectului devine /_/). -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!--
      API-ul CounterStrikeSharp (doar referință: biblioteca o aduce framework-ul de pe server). Versiune fixă, ca
      fiecare compilare să dea același rezultat: 1.0.368 e ultima pentru net8.0 (de la 1.0.369 pachetul cere net10.0 și
      .NET SDK 10). Pluginul net8.0 rulează și pe CounterStrikeSharp-ul nou, cu runtime-ul .NET 10.
    -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.368">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
