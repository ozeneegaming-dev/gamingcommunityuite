<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GCS Server Bridge pentru Counter-Strike 2 (CounterStrikeSharp, .NET 8). Licența: MIT (vezi LICENSE).
    Compilare: dotnet build -c Release (vezi servers-plugins/README.md). Rezultatul: bin/Release/net8.0/GcsBridge.dll,
    copiat în addons/counterstrikesharp/plugins/GcsBridge/.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GcsBridge</AssemblyName>
    <RootNamespace>Gcs.Bridge</RootNamespace>
    <Version>1.0.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- API-ul CounterStrikeSharp (doar referință: biblioteca o aduce framework-ul de pe server). -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
