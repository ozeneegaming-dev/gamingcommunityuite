{
  "key": "redline-official",
  "name": "RED-LINE OFFICIAL",
  "description": "Temă gaming cyber neon (mov electric + cyan): antet cu grilă și linie neon animată, benzi cu majuscule, butoane cu strălucire, rânduri care se aprind la hover, mod întunecat și luminos.",
  "author": "RED-LINE",
  "cssFiles": ["redline-core.css", "redline-components.css", "redline-pages.css"],
  "settings": {
    "preset": "nova",
    "dark": {
      "bg": "#07060D",
      "surface": "#110F1C",
      "surface2": "#171428",
      "border": "#262140",
      "text": "#E4E1F2",
      "muted": "#9A93B8",
      "accent": "#8B3DFF",
      "accentInk": "#22E4FF",
      "chrome": "#0A0814",
      "chrome2": "#0D0B19",
      "ok": "#2BF59B",
      "warn": "#FFB020"
    },
    "light": {
      "bg": "#F3F1FA",
      "surface": "#FFFFFF",
      "surface2": "#F0EDF9",
      "border": "#DDD7EE",
      "text": "#1A1530",
      "muted": "#5D5778",
      "accent": "#7A2BF0",
      "accentInk": "#0A7FA3",
      "chrome": "#FFFFFF",
      "chrome2": "#F7F5FC",
      "ok": "#12935A",
      "warn": "#A86400"
    },
    "fontDisplay": "Rajdhani",
    "fontText": "Inter",
    "radius": 10,
    "width": 1400,
    "elements": {
      "dark": {
        "bodyBg": "@bg",
        "heading": "#FFFFFF",
        "link": "#FFFFFF",
        "linkHover": "@accentInk",
        "headerBg": "@chrome",
        "headerText": "#CFC8EA",
        "footerBg": "@chrome",
        "footerText": "@text",
        "drawerBg": "@surface",
        "drawerText": "@text",
        "boxBg": "@surface",
        "boxBorder": "@border",
        "boxHeaderBg": "@surface2",
        "boxHeaderText": "#FFFFFF",
        "widgetTitle": "#FFFFFF",
        "widgetIcon": "@accentInk",
        "btnPrimaryBg": "@accent",
        "btnPrimaryText": "#FFFFFF",
        "btnSecondaryBg": "#1F1A33",
        "btnSecondaryText": "#FFFFFF"
      },
      "light": {
        "bodyBg": "@bg",
        "heading": "#120E24",
        "link": "@text",
        "linkHover": "@accent",
        "headerBg": "#0A0814",
        "headerText": "#CFC8EA",
        "footerBg": "@chrome",
        "footerText": "@text",
        "drawerBg": "@surface",
        "drawerText": "@text",
        "boxBg": "@surface",
        "boxBorder": "@border",
        "boxHeaderBg": "@surface2",
        "boxHeaderText": "@text",
        "widgetTitle": "@text",
        "widgetIcon": "@accent",
        "btnPrimaryBg": "@accent",
        "btnPrimaryText": "#FFFFFF",
        "btnSecondaryBg": "#ECE8F7",
        "btnSecondaryText": "@text"
      }
    },
    "scheme": { "default": "dark", "toggle": true },
    "logo": { "text": "", "slogan": "", "font": "display", "weight": 700, "size": 26, "sizeMobile": 20, "textMobile": true, "height": 70, "heightMobile": 70 },
    "layout": { "forumIndex": "list", "topicView": "normal", "featureFirstPost": true },
    "typography": { "baseSize": 14, "contentSize": 100, "fontDisplayCustom": "", "fontTextCustom": "" },
    "header": { "height": 80, "heightMobile": 62, "navIcons": true, "sticky": false, "overlay": 55, "pattern": true, "crumbs": true },
    "mobileNav": { "side": "left", "icons": true },
    "boxes": { "borderWidth": 1, "shadow": "soft", "clickableRows": true },
    "sidebar": { "width": 340, "position": "right", "sticky": false },
    "avatars": { "rounded": true },
    "buttons": { "radius": 6 },
    "bands": { "style": "solid", "icon": "rounded" },
    "effects": { "hover": true }
  }
}
